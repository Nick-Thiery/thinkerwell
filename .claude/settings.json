{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_content_edit.py\"",
            "timeout": 90,
            "statusMessage": "Checking the content file"
          }
        ]
      }
    ]
  }
}
